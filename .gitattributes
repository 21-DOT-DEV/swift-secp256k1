# Auto-detect text files and normalize line endings
* text=auto

# Swift files
*.swift text diff=swift

# C files (upstream library code)
*.c text diff=c
*.h text diff=c

# Upstream C library in Sources should be marked as vendored
Sources/libsecp256k1/src/**         linguist-vendored
Sources/libsecp256k1/include/**     linguist-vendored
Sources/libsecp256k1_zkp/src/**     linguist-vendored
Sources/libsecp256k1_zkp/include/** linguist-vendored
Sources/Shared/swift-crypto/**      linguist-vendored

# Custom utility files (not vendored)
Sources/libsecp256k1/src/Utility.c          linguist-vendored=false
Sources/libsecp256k1/include/Utility.h      linguist-vendored=false
Sources/libsecp256k1_zkp/src/Utility.c      linguist-vendored=false
Sources/libsecp256k1_zkp/include/Utility.h  linguist-vendored=false

# Development directories
Projects/**                 export-ignore
Projects/Sources/libsecp256k1Tests/** linguist-vendored
Projects/Resources/WycheproofTests/secp256k1/** linguist-vendored
.build/**                   export-ignore linguist-vendored
.build_custom/**            export-ignore linguist-vendored
.github/**                  export-ignore linguist-vendored
.vscode/**                  export-ignore linguist-vendored
.swiftpm/**                 export-ignore linguist-vendored
Development/**              export-ignore linguist-vendored
.vale/**                    export-ignore linguist-vendored
.vale.ini                   export-ignore

# CI/CD and tooling configs
bitrise.yml                 export-ignore
Dockerfile                  export-ignore
.dockerignore               export-ignore
lefthook.yml                export-ignore
vendir.yml                  export-ignore
vendir.lock.yml             export-ignore linguist-generated
.spi.yml                    export-ignore
.swiftformat                export-ignore
.swiftlint.yml              export-ignore

# Git and editor files
.gitignore                  export-ignore
.gitmodules                 export-ignore
.DS_Store                   export-ignore

# Package lockfile (not needed for library consumers)
Package.resolved            export-ignore linguist-generated
